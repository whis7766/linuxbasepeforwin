# linuxbasepeforwin - x86_64 Live RAM maintenance system
# Architecture / toolchain
# Baseline x86-64 (SSE2) so the PE boots on any 64-bit PC / default VM CPU,
# not only Nehalem+ (corei7 emitted SSE4.1 => SIGILL on qemu64).
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_12=y
BR2_CCACHE=y
BR2_ENABLE_LTO=y

# System
BR2_TARGET_GENERIC_HOSTNAME="linuxbasepe"
BR2_TARGET_GENERIC_ISSUE="linuxbasepeforwin"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_SYSTEM_BIN_SH_BASH=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BASH=y
BR2_INIT_BUSYBOX=y

# Kernel (initramfs embedded => true RAM system)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LINUXBASEPE_PATH)/board/linuxbasepe/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_TARGET_ROOTFS_INITRAMFS=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Boot: ISO wrapped by host grub-mkrescue (BIOS+UEFI) in post-image.sh

# GUI: Qt6 widgets on linuxfb
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_QT6BASE_LINUXFB=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_WQY_ZENHEI=y
BR2_PACKAGE_LBPE_GUI=y

# Storage libs (GUI uses native ioctl/lib APIs, not CLI tools)
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_ATTR=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_WIMLIB=y
BR2_PACKAGE_HIVEX=y

# Image generation
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LINUXBASEPE_PATH)/board/linuxbasepe/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_LINUXBASEPE_PATH)/board/linuxbasepe/post-image.sh"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LINUXBASEPE_PATH)/board/linuxbasepe/rootfs-overlay"